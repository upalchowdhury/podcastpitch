{
    "name": "@podcast-pitch/backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/api/server.ts",
        "dev:worker": "tsx watch src/worker/server.ts",
        "build": "tsc",
        "start": "node dist/api/server.js",
        "start:worker": "node dist/worker/server.js",
        "lint": "eslint src --ext .ts",
        "test": "vitest",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "seed:podcasts": "tsx src/scripts/seed-podcasts.ts",
        "import:podcastindex": "tsx src/scripts/import-from-podcastindex.ts"
    },
    "dependencies": {
        "@google-cloud/secret-manager": "^5.0.1",
        "@google-cloud/tasks": "^4.0.1",
        "@podcast-pitch/shared": "workspace:*",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "drizzle-orm": "^0.29.3",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^6.9.8",
        "@google/generative-ai": "^0.21.0",
        "pg": "^8.11.3",
        "pino": "^8.17.2",
        "pino-http": "^9.0.0",
        "uuid": "^9.0.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.6",
        "@types/nodemailer": "^6.4.14",
        "@types/pg": "^8.10.9",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "drizzle-kit": "^0.20.10",
        "eslint": "^8.56.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.1.3"
    }
}