# PodcastPitch Backend Environment Variables

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WORKER_PORT=3002

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/podcast_pitch

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_TASKS_QUEUE=email-send-queue
CLOUD_TASKS_LOCATION=us-central1

# URLs
API_URL=http://localhost:3001
WORKER_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# AI - Gemini
GEMINI_API_KEY=

# Podcast Index API (get keys at https://api.podcastindex.org/signup)
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Email / Smartlead (optional)
SMARTLEAD_API_KEY=
SMARTLEAD_ENABLED=false

# Limits
DEFAULT_DAILY_SEND_LIMIT=50
DEFAULT_MONTHLY_SEND_LIMIT=500

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
