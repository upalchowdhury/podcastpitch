# Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development
ENV=dev  # dev | staging | prod

# =============================================================================
# DATABASE (Cloud SQL PostgreSQL)
# =============================================================================
# For local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/podcast_pitch

# For Cloud SQL (set by Cloud Run):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Cloud SQL Connection Name (for Cloud Run)
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# =============================================================================
# AUTHENTICATION (Google Identity Platform)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=your-jwt-secret-min-32-chars

# =============================================================================
# EMAIL PROVIDERS
# =============================================================================
# Default SMTP (user-provided credentials stored in Secret Manager)
# SMTP credentials are stored per-user, not globally

# Smartlead (optional integration)
SMARTLEAD_API_KEY=
SMARTLEAD_ENABLED=false

# =============================================================================
# GCP CONFIGURATION
# =============================================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Cloud Tasks
CLOUD_TASKS_QUEUE=email-send-queue
CLOUD_TASKS_LOCATION=us-central1

# Service URLs (set by Cloud Run)
API_URL=http://localhost:3001
WORKER_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AI / LLM Configuration
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# RATE LIMITING
# =============================================================================
DEFAULT_DAILY_SEND_LIMIT=50
DEFAULT_MONTHLY_SEND_LIMIT=500

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# SECRETS (Reference names in Secret Manager)
# =============================================================================
# These are reference names, not actual secrets
# SECRET_JWT=projects/PROJECT_ID/secrets/jwt-secret/versions/latest
